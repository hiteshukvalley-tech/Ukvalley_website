# Copy to .env.local for local development. On Render, set the same keys in
# the service's Environment tab (render.yaml lists them).

# Site addresses (read at build time). Frontend = the public website; backend =
# the admin panel and server routes. One app serves both, at the same address.
# (If they are ever set to different domains, /admin is sent to the backend and
# public pages to the frontend.) On localhost everything is served as usual.
NEXT_PUBLIC_SITE_URL=https://uat.ukvalley.com
NEXT_PUBLIC_API_URL=https://uat.ukvalley.com

# Admin panel owner account — always an admin, works even with no database.
# More logins (admins and editors) are added in the panel under Users.
# Use a long, unique passphrase; changing it signs the owner out everywhere.
ADMIN_EMAIL=admin@ukvalley.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# MongoDB (Atlas or self-hosted). Include the database name in the URI, or set MONGODB_DB.
# Atlas: Network Access must allow Render's outbound IPs (service → Connect → Outbound) or 0.0.0.0/0.
MONGODB_URI=
MONGODB_DB=ukvalley

# Outgoing email for the admin "Forgot password" codes. Without these, password
# reset by email is switched off. Gmail: smtp.gmail.com, port 465, and an App
# Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ukvalley Admin <you@example.com>
