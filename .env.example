# Copy to .env.local for local development. On Render, set the same keys in
# the service's Environment tab (render.yaml lists them).

# Site addresses (read at build time). Frontend = the public website; backend =
# the admin panel and server routes. One app serves both, at the same address.
# (If they are ever set to different domains, /admin is sent to the backend and
# public pages to the frontend.) On localhost everything is served as usual.
NEXT_PUBLIC_SITE_URL=https://ukvalley.com
NEXT_PUBLIC_API_URL=https://ukvalley.com

# Admin panel owner account — always an admin, works even with no database.
# More logins (admins and editors) are added in the panel under Users.
# Use a long, unique passphrase; changing it signs the owner out everywhere.
ADMIN_EMAIL=admin@ukvalley.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# MongoDB (Atlas or self-hosted). Include the database name in the URI, or set MONGODB_DB.
# Atlas: Network Access must allow Render's outbound IPs (service → Connect → Outbound) or 0.0.0.0/0.
MONGODB_URI=
MONGODB_DB=ukvalley

# Outgoing email for the admin "Forgot password" codes. Without these, password
# reset by email is switched off. Gmail: smtp.gmail.com, port 465, and an App
# Password (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ukvalley Admin <you@example.com>
# Optional: ssl | starttls | none. Unset = ssl on port 465, starttls on any other.
SMTP_SECURITY=

# Set to 1 only when every request reaches the server through Cloudflare (the
# origin refuses direct traffic). Then the visitor IP for rate limits comes
# from CF-Connecting-IP; otherwise from the last X-Forwarded-For entry, which
# Render's proxy adds. Leave unset while the *.onrender.com address is open.
TRUST_CLOUDFLARE=
# RENDER_EXTERNAL_HOSTNAME is set by Render itself (the service's own
# *.onrender.com address); it is trusted as this site's host. No need to set it.

# Google Tag Manager (read at build time: rebuild after changing). Only the GTM
# container is in the code; add GA4, Meta Pixel etc. inside the GTM dashboard.
# Empty → no tracking. NEXT_PUBLIC_GTM_ENABLED=false switches it off for an
# environment. Never loaded on /admin.
NEXT_PUBLIC_GTM_ID=GTM-N7FRXW7H
NEXT_PUBLIC_GTM_ENABLED=true

# Web3Forms (https://web3forms.com): emails a copy of every contact-form and
# scoping-popup enquiry to the key's inbox (leads are still saved in
# Admin → Leads). Read at build time: rebuild after changing. Empty → off.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ── AI interviews (Admin → AI interviews) ─────────────────────────────────
# Everything below is optional, and can instead be entered (encrypted) in
# Admin → Site settings → API keys, which wins over these values and needs no
# restart. A missing integration is shown as "not set up" on the AI interviews
# settings page and that channel is skipped.
#
# Claude (question writing + evaluation). AI_INTERVIEW_PROVIDER=mock runs the
# whole flow with canned questions/scores for local testing, without an API key.
ANTHROPIC_API_KEY=
# Deepgram live speech-to-text for candidates' spoken answers (any browser).
# Empty: the browser's own speech recognition (Chrome / Edge). Also settable in
# Admin -> API keys -> Speech-to-text. Model default nova-3; language auto
# (follows the interview language) | en-IN | en | hi | multi (Hinglish).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
DEEPGRAM_LANGUAGE=
AI_INTERVIEW_MODEL=claude-opus-5-5
AI_INTERVIEW_PROVIDER=
# Where interview links point. Empty → SITE_URL. Set to http://localhost:3000
# only when testing locally.
INTERVIEW_BASE_URL=
#
# Recordings: "gridfs" (default, stored in MongoDB) or "s3". Recordings are
# encrypted either way; RECORDING_ENCRYPTION_KEY adds a key on top of
# AUTH_SECRET (changing either makes existing recordings unreadable).
RECORDING_STORAGE=gridfs
RECORDING_ENCRYPTION_KEY=
# Only for RECORDING_STORAGE=s3 (private bucket; credentials via the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables).
S3_RECORDINGS_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
#
# Google Calendar (OAuth web client in Google Cloud Console, Calendar API on).
# Authorised redirect URI: <site>/admin/ai-interviews/settings/google/callback
# Then click "Connect Google Calendar" in Admin → AI interviews → Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# WhatsApp Business Cloud API (Meta). Templates must be approved in WhatsApp
# Manager; their names are set in Admin → AI interviews → Settings.
# Delivery webhook: <site>/whatsapp/webhook, verify token = WHATSAPP_VERIFY_TOKEN.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
